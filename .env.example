ANTHROPIC_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public-by-design (Settings -> API in the Supabase dashboard) — served to
# the browser via GET /api/config so the static frontend can talk to
# Supabase Auth directly. RLS (migration 0006), not secrecy of this key, is
# what protects data.
SUPABASE_ANON_KEY=
APIFY_TOKEN=
APIFY_ACTOR_ID=
FIRECRAWL_API_KEY=
# Gmail address + an App Password (myaccount.google.com -> Security -> App
# passwords; requires 2FA on the account) — used only for the run-complete
# notification email, not for Supabase Auth's own signup/reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Base URL this app is actually reachable at — used to build the "view
# results" link in the notification email. http://localhost:3000 in dev.
APP_BASE_URL=http://localhost:3000
PORT=3000
# MAX_CANDIDATES is no longer set here — it self-calibrates from real
# observed Apify cost in the discovery_calibration table (see
# supabase/migrations/0003_discovery_calibration.sql and src/lib/apify.ts).
MAX_SCRAPES=20
MAX_TURNS=40
MAX_BUDGET_USD=3
MAX_DISCOVERY_BUDGET_USD=1
# Hard ceiling on total real Apify $ spent on discovery in a single run,
# independent of calibration (see MAX_DISCOVERY_SPEND_PER_RUN_USD in
# src/lib/apify.ts) — a backstop against a real per-event price spike that
# the count-based limits alone wouldn't catch in time.
MAX_DISCOVERY_SPEND_PER_RUN_USD=2
TARGET_QUALIFIED_LEADS=10
REGENERATE_LIMIT=3
REGENERATE_WINDOW_MINUTES=30
