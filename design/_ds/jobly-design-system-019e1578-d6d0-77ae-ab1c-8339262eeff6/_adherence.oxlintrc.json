{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-hover",
      "--accent-muted",
      "--accent-subtle",
      "--bg-app",
      "--bg-elevated",
      "--bg-overlay",
      "--bg-subtle",
      "--bg-surface",
      "--border-default",
      "--border-faint",
      "--border-strong",
      "--dur-drawer",
      "--dur-micro",
      "--dur-panel",
      "--ease-out",
      "--error",
      "--error-subtle",
      "--font-display",
      "--font-mono",
      "--font-sans",
      "--fw-2xl",
      "--fw-base",
      "--fw-lg",
      "--fw-md",
      "--fw-sm",
      "--fw-xl",
      "--fw-xs",
      "--info",
      "--info-subtle",
      "--lh-2xl",
      "--lh-base",
      "--lh-lg",
      "--lh-md",
      "--lh-sm",
      "--lh-xl",
      "--lh-xs",
      "--match-high",
      "--match-low",
      "--match-mid",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--radius-xl",
      "--ring",
      "--space-1",
      "--space-12",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-8",
